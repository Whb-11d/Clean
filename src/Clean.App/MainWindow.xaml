<Window x:Class="Clean.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Clean · 看得见的磁盘清理" Width="1180" Height="800" MinWidth="900" MinHeight="620" Background="#F3F6F9" Foreground="#223347" FontFamily="Microsoft YaHei UI" FontSize="13" WindowStartupLocation="CenterScreen">
  <Window.Resources>
    <DataTemplate x:Key="ScanResults">
      <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <TextBlock Text="{Binding ScanSummary}" Margin="0,10,0,10"/>
        <DockPanel Grid.Row="1" Margin="0,0,0,12">
          <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button Content="取消勾选" Command="{Binding ClearSelectionCommand}" Background="#657689"/><Button Content="生成清理预览 →" Command="{Binding BuildPlanCommand}"/></StackPanel>
          <TextBlock Text="{Binding SelectionSummary}" VerticalAlignment="Center"/>
        </DockPanel>
        <DataGrid Grid.Row="2" ItemsSource="{Binding Candidates}" IsEnabled="{Binding Idle}" SelectionMode="Extended" AutomationProperties.Name="扫描候选文件">
          <DataGrid.Columns>
            <DataGridTemplateColumn Header="选择" Width="55"><DataGridTemplateColumn.CellTemplate><DataTemplate><CheckBox IsChecked="{Binding Selected, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center" VerticalAlignment="Center" AutomationProperties.Name="选择此文件"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
            <DataGridTextColumn Header="文件路径" Binding="{Binding Path}" Width="*" IsReadOnly="True"><DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="ToolTip" Value="{Binding Path}"/><Setter Property="TextTrimming" Value="CharacterEllipsis"/><Setter Property="TextWrapping" Value="NoWrap"/><Setter Property="VerticalAlignment" Value="Center"/></Style></DataGridTextColumn.ElementStyle></DataGridTextColumn>
            <DataGridTextColumn Header="逻辑大小" Binding="{Binding Size}" SortMemberPath="Bytes" Width="105" IsReadOnly="True"/>
            <DataGridTextColumn Header="修改时间" Binding="{Binding Modified}" Width="160" IsReadOnly="True"/>
            <DataGridTextColumn Header="规则 / 风险" Binding="{Binding Reason}" Width="200" IsReadOnly="True"/>
          </DataGrid.Columns>
        </DataGrid>
        <Expander Grid.Row="3" Header="扫描错误详情（最多保留 1000 条）" Margin="0,10,0,0">
          <DataGrid ItemsSource="{Binding ScanIssues}" Height="120" IsReadOnly="True"><DataGrid.Columns><DataGridTextColumn Header="路径" Binding="{Binding Path}" Width="*"/><DataGridTextColumn Header="原因" Binding="{Binding Message}" Width="300"/></DataGrid.Columns></DataGrid>
        </Expander>
      </Grid>
    </DataTemplate>
  </Window.Resources>
  <Grid>
    <Grid.ColumnDefinitions><ColumnDefinition Width="195"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Border Background="#172A3A"><DockPanel Margin="18,28,18,20">
      <StackPanel DockPanel.Dock="Top" Margin="10,0,0,30"><TextBlock Text="◉  Clean" Foreground="White" FontSize="29" FontWeight="SemiBold"/><TextBlock Text="让每一次清理都有依据" Foreground="#98AEBE" Margin="0,9,0,0" FontSize="12"/></StackPanel>
      <ListBox SelectedIndex="{Binding SelectedPage}" Background="Transparent" BorderThickness="0" Foreground="#A3B8CC" VerticalAlignment="Top" AutomationProperties.Name="页面导航">
        <ListBox.Resources><Style TargetType="TextBlock"><Setter Property="Foreground" Value="#A3B8CC"/></Style></ListBox.Resources>
        <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="Padding" Value="15,13"/><Setter Property="Margin" Value="0,0,0,5"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border x:Name="ItemSurface" Background="Transparent" CornerRadius="7" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="ItemSurface" Property="Background" Value="#294757"/><Setter Property="Foreground" Value="White"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ItemSurface" Property="Background" Value="#233E50"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style></ListBox.ItemContainerStyle>
        <ListBoxItem><TextBlock Text="概览" Foreground="#A3B8CC"/></ListBoxItem><ListBoxItem><TextBlock Text="临时文件" Foreground="#A3B8CC"/></ListBoxItem><ListBoxItem><TextBlock Text="清理预览与结果" Foreground="#A3B8CC"/></ListBoxItem><ListBoxItem><TextBlock Text="大文件分析" Foreground="#A3B8CC"/></ListBoxItem><ListBoxItem><TextBlock Text="内存监控" Foreground="#A3B8CC"/></ListBoxItem><ListBoxItem><TextBlock Text="设置与历史" Foreground="#A3B8CC"/></ListBoxItem>
      </ListBox>
    </DockPanel></Border>
    <Grid Grid.Column="1">
      <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <TabControl SelectedIndex="{Binding SelectedPage}" Background="Transparent" BorderThickness="0" Margin="28,28,28,18">
        <TabControl.Resources><Style TargetType="TabItem"><Setter Property="Visibility" Value="Collapsed"/></Style></TabControl.Resources>
        <TabItem><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
          <TextBlock Text="了解空间，再做决定" Style="{StaticResource Title}"/><TextBlock Text="只扫描你允许的位置。每个候选文件，都能查看路径、依据和处理方式。" Style="{StaticResource Subtitle}"/>
          <Border Style="{StaticResource Card}"><StackPanel><DockPanel><Button DockPanel.Dock="Right" Content="刷新概览" Command="{Binding RefreshOverviewCommand}"/><TextBlock Text="本地磁盘" FontSize="18" FontWeight="SemiBold"/></DockPanel>
            <ItemsControl ItemsSource="{Binding DiskRows}" Margin="0,16,0,0"><ItemsControl.ItemTemplate><DataTemplate><Grid Margin="0,0,0,16"><Grid.ColumnDefinitions><ColumnDefinition Width="55"/><ColumnDefinition Width="*"/><ColumnDefinition Width="230"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Name}" FontSize="17"/><ProgressBar Grid.Column="1" Value="{Binding UsedPercent}" Height="9" Foreground="{StaticResource Accent}" Background="#E6EEF1" BorderThickness="0" VerticalAlignment="Center"/><StackPanel Grid.Column="2" Margin="18,0,0,0"><TextBlock><Run Text="可用 "/><Run Text="{Binding Available}"/><Run Text=" / "/><Run Text="{Binding Total}"/></TextBlock><TextBlock Text="{Binding Error}" Foreground="#A23E32"/></StackPanel></Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
          </StackPanel></Border>
          <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="物理内存" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="{Binding MemorySummary}" Margin="0,12,0,12"/><ProgressBar Value="{Binding MemoryPercent}" Height="9" Foreground="#5687AF" Background="#E6EEF1" BorderThickness="0"/><TextBlock Text="使用量 = 总量 − 可用量。内存监控页可查看进程工作集。" Foreground="#657689" Margin="0,12,0,0"/></StackPanel></Border>
          <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Windows 回收站" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="{Binding BinSummary}" Margin="0,10,0,14"/><WrapPanel><Button Content="打开回收站 / 手动还原" Command="{Binding OpenBinCommand}"/><Button Content="单独清空回收站…" Command="{Binding EmptyBinCommand}" Background="#A54B3F"/></WrapPanel><TextBlock Text="移入回收站通常不释放磁盘空间。清空回收站不可由本应用恢复。" Foreground="#657689" Margin="0,14,0,0"/></StackPanel></Border>
          <TextBlock Text="普通权限运行 · 无账户、广告或遥测 · 不清理注册表，不结束进程" Foreground="#657689"/>
        </StackPanel></ScrollViewer></TabItem>
        <TabItem><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
          <StackPanel><TextBlock Text="临时文件" Style="{StaticResource Title}"/><TextBlock Text="时间较久只代表值得检查，不代表一定可以删除。所有结果默认不勾选。" Style="{StaticResource Subtitle}"/><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="{Binding TemporaryDirectory}" FontFamily="Consolas" Margin="0,0,0,14"/><WrapPanel VerticalAlignment="Center"><TextBlock Text="排除最近" VerticalAlignment="Center"/><TextBox Text="{Binding AgeDaysText, UpdateSourceTrigger=PropertyChanged}" Width="65" Margin="10,0" IsEnabled="{Binding Idle}" AutomationProperties.Name="临时文件天数阈值"/><TextBlock Text="天内修改的文件" VerticalAlignment="Center" Margin="0,0,20,0"/><Button Content="开始只读扫描" Command="{Binding ScanTemporaryCommand}"/></WrapPanel></StackPanel></Border></StackPanel>
          <ContentControl Grid.Row="1" Content="{Binding}" ContentTemplate="{StaticResource ScanResults}"/>
        </Grid></TabItem>
        <TabItem><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="2*"/><RowDefinition Height="Auto"/><RowDefinition Height="3*"/></Grid.RowDefinitions>
          <StackPanel><TextBlock Text="清理预览与结果" Style="{StaticResource Title}"/><TextBlock Text="核对每一个路径。只处理此计划中的文件，不追加新发现的项目。" Style="{StaticResource Subtitle}"/></StackPanel>
          <Border Grid.Row="1" Style="{StaticResource Card}"><StackPanel><WrapPanel Margin="0,0,0,12"><CheckBox Content="使用永久删除（不可恢复，需单独确认）" IsChecked="{Binding Permanent}" IsEnabled="{Binding Idle}" VerticalAlignment="Center" Margin="0,0,16,0"/><Button Content="重新生成预览" Command="{Binding BuildPlanCommand}"/><Button Content="确认并执行…" Command="{Binding ExecutePlanCommand}"/></WrapPanel><TextBlock Text="{Binding PlanSummary}" FontWeight="SemiBold"/></StackPanel></Border>
          <DataGrid Grid.Row="2" ItemsSource="{Binding PlanItems}" IsReadOnly="True" AutomationProperties.Name="待执行清理计划"><DataGrid.Columns><DataGridTextColumn Header="批准的文件路径" Binding="{Binding Path}" Width="*"/><DataGridTextColumn Header="字节数" Binding="{Binding Bytes}" Width="110"/><DataGridTextColumn Header="规则依据" Binding="{Binding Reason}" Width="260"/></DataGrid.Columns></DataGrid>
          <StackPanel Grid.Row="3" Margin="0,16,0,12"><TextBlock Text="{Binding ReportSummary}" FontWeight="SemiBold"/><TextBlock Text="{Binding SpaceSummary}" Foreground="#657689" Margin="0,6,0,0"/></StackPanel>
          <DataGrid Grid.Row="4" ItemsSource="{Binding Results}" IsReadOnly="True" AutomationProperties.Name="逐项执行结果"><DataGrid.Columns><DataGridTextColumn Header="路径" Binding="{Binding Path}" Width="*"/><DataGridTextColumn Header="状态" Binding="{Binding Status}" Width="65"/><DataGridTextColumn Header="方式" Binding="{Binding Mode}" Width="80"/><DataGridTextColumn Header="逻辑大小" Binding="{Binding Size}" Width="100"/><DataGridTextColumn Header="结果说明" Binding="{Binding Message}" Width="280"/></DataGrid.Columns></DataGrid>
        </Grid></TabItem>
        <TabItem><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
          <StackPanel><TextBlock Text="大文件分析" Style="{StaticResource Title}"/><TextBlock Text="大文件不等于垃圾。选择普通本地目录，仅分析你指定的范围。" Style="{StaticResource Subtitle}"/><Border Style="{StaticResource Card}"><StackPanel><DockPanel Margin="0,0,0,12"><Button DockPanel.Dock="Right" Content="选择目录…" Command="{Binding BrowseFolderCommand}" Margin="10,0,0,0"/><TextBox Text="{Binding LargeFolder, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding Idle}" AutomationProperties.Name="大文件分析目录"/></DockPanel><WrapPanel><TextBlock Text="最低大小" VerticalAlignment="Center"/><TextBox Text="{Binding MinimumMiBText, UpdateSourceTrigger=PropertyChanged}" Width="90" Margin="10,0" IsEnabled="{Binding Idle}" AutomationProperties.Name="大文件最低大小"/><TextBlock Text="MiB" VerticalAlignment="Center" Margin="0,0,20,0"/><Button Content="开始大文件分析" Command="{Binding ScanLargeCommand}"/></WrapPanel></StackPanel></Border></StackPanel>
          <ContentControl Grid.Row="1" Content="{Binding}" ContentTemplate="{StaticResource ScanResults}"/>
        </Grid></TabItem>
        <TabItem><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><StackPanel><TextBlock Text="内存监控" Style="{StaticResource Title}"/><TextBlock Text="查看占用，不干扰程序运行。此页面可见时约每 2 秒刷新。" Style="{StaticResource Subtitle}"/><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="{Binding MemorySummary}" FontSize="18"/><ProgressBar Value="{Binding MemoryPercent}" Height="10" Margin="0,16,0,12" Foreground="#5687AF" Background="#E6EEF1" BorderThickness="0"/><TextBlock Text="{Binding MemoryTimestamp}" Foreground="#657689"/></StackPanel></Border><TextBlock Text="进程工作集包含共享页，不能相加作为系统内存用量。" Margin="0,0,0,12"/></StackPanel><DataGrid Grid.Row="1" ItemsSource="{Binding ProcessRows}" IsReadOnly="True"><DataGrid.Columns><DataGridTextColumn Header="PID" Binding="{Binding Id}" Width="90"/><DataGridTextColumn Header="进程名称" Binding="{Binding Name}" Width="*"/><DataGridTextColumn Header="工作集（按占用降序）" Binding="{Binding WorkingSet}" Width="240" CanUserSort="False"/></DataGrid.Columns></DataGrid></Grid></TabItem>
        <TabItem><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel><TextBlock Text="设置与历史" Style="{StaticResource Title}"/><TextBlock Text="配置只保存在本机。排除目录在扫描和执行前都会检查。" Style="{StaticResource Subtitle}"/>
          <Border Style="{StaticResource Card}"><StackPanel><DockPanel Margin="0,0,0,12"><Button DockPanel.Dock="Right" Content="添加排除目录…" Command="{Binding AddExclusionCommand}"/><TextBlock Text="排除目录 · 每行一个完整路径" FontWeight="SemiBold" VerticalAlignment="Center"/></DockPanel><TextBox Text="{Binding ExclusionsText, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" Height="110" VerticalScrollBarVisibility="Auto" IsEnabled="{Binding Idle}" AutomationProperties.Name="排除目录列表"/><WrapPanel Margin="0,16,0,16"><TextBlock Text="临时文件最低年龄（天）" VerticalAlignment="Center"/><TextBox Text="{Binding AgeDaysText, UpdateSourceTrigger=PropertyChanged}" Width="70" Margin="10,0,20,0" IsEnabled="{Binding Idle}"/><TextBlock Text="大文件阈值（MiB）" VerticalAlignment="Center"/><TextBox Text="{Binding MinimumMiBText, UpdateSourceTrigger=PropertyChanged}" Width="90" Margin="10,0" IsEnabled="{Binding Idle}"/></WrapPanel><Button Content="保存设置" Command="{Binding SaveSettingsCommand}" HorizontalAlignment="Left"/></StackPanel></Border>
          <DockPanel Margin="0,0,0,12"><Button DockPanel.Dock="Right" Content="清除历史与日志" Command="{Binding ClearHistoryCommand}" Background="#657689"/><TextBlock Text="最近 50 次清理摘要" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center"/></DockPanel>
          <DataGrid ItemsSource="{Binding HistoryRows}" Height="230" IsReadOnly="True"><DataGrid.Columns><DataGridTextColumn Header="时间" Binding="{Binding Started, StringFormat=yyyy-MM-dd HH:mm}" Width="150"/><DataGridTextColumn Header="状态" Binding="{Binding State}" Width="*"/><DataGridTextColumn Header="计划" Binding="{Binding Planned}" Width="60"/><DataGridTextColumn Header="回收站" Binding="{Binding Recycled}" Width="65"/><DataGridTextColumn Header="永久" Binding="{Binding Deleted}" Width="60"/><DataGridTextColumn Header="失败" Binding="{Binding Failed}" Width="60"/><DataGridTextColumn Header="跳过" Binding="{Binding Skipped}" Width="60"/><DataGridTextColumn Header="未执行" Binding="{Binding NotExecuted}" Width="70"/></DataGrid.Columns></DataGrid>
          <TextBlock Text="本地数据位置" Margin="0,16,0,4" Foreground="#657689"/><TextBlock Text="{Binding StateDirectory}" FontFamily="Consolas"/><TextBlock Text="历史仅保留摘要。完整文件路径仅在当前扫描、预览和结果中显示。诊断日志不记录路径。" Margin="0,8,0,0" Foreground="#657689"/>
        </StackPanel></ScrollViewer></TabItem>
      </TabControl>
      <Border Grid.Row="1" Background="White" BorderBrush="#E2E9EF" BorderThickness="0,1,0,0" Padding="24,14"><DockPanel><Button DockPanel.Dock="Right" Content="停止后续操作" Command="{Binding CancelCommand}" IsEnabled="{Binding Busy}" Background="#657689" Margin="16,0,0,0"/><TextBlock Text="{Binding Status}" VerticalAlignment="Center" MaxHeight="75" AutomationProperties.LiveSetting="Polite"/></DockPanel></Border>
    </Grid>
  </Grid>
</Window>
