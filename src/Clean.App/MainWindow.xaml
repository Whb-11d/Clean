<Window x:Class="Clean.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Clean" Icon="Assets/Clean.ico" Width="1120" Height="780" MinWidth="940" MinHeight="660" Background="#F5F7FA" Foreground="#223347" FontFamily="Microsoft YaHei UI" FontSize="13" WindowStartupLocation="CenterScreen" UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
  <Window.Resources>
    <DataTemplate x:Key="ScanResults">
      <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <TextBlock Text="{Binding ScanSummary}" Margin="0,10,0,10"/>
        <StackPanel Grid.Row="1" Margin="0,0,0,8">
          <WrapPanel><Button Content="本次结果" Command="{Binding ShowReportCommand}" Visibility="{Binding HasResults, Converter={StaticResource VisibleWhenTrue}}" Style="{StaticResource SecondaryButton}"/><Button Content="勾选筛选结果" Command="{Binding SelectFilteredCommand}" Style="{StaticResource SecondaryButton}"/><Button Content="取消全部勾选" Command="{Binding ClearSelectionCommand}" Style="{StaticResource SecondaryButton}"/><Button Content="生成清理预览 →" Command="{Binding BuildPlanCommand}"/></WrapPanel>
          <TextBlock Text="{Binding SelectionSummary}" Margin="0,6,0,0" AutomationProperties.LiveSetting="Polite"/>
        </StackPanel>
        <DockPanel Grid.Row="2" Margin="0,0,0,8">
          <TextBlock DockPanel.Dock="Right" Text="{Binding FilterSummary}" Margin="12,0,0,0" VerticalAlignment="Center"/>
          <TextBlock Text="搜索路径" Margin="0,0,10,0" VerticalAlignment="Center"/>
          <TextBox Text="{Binding CandidateSearch, UpdateSourceTrigger=PropertyChanged, Delay=200}" IsEnabled="{Binding Idle}" AutomationProperties.Name="搜索候选文件路径" ToolTip="按路径关键词筛选；清空搜索可查看全部文件。筛选不改变已勾选项。"/>
        </DockPanel>
        <Border Grid.Row="3" Style="{StaticResource Card}" VerticalAlignment="Top" Visibility="{Binding NoMatchingCandidates, Converter={StaticResource VisibleWhenTrue}}">
          <StackPanel><TextBlock Text="没有匹配的文件" FontWeight="SemiBold"/><TextBlock Text="请修改或清空搜索关键词。已勾选文件仍保留在清理范围内。" Margin="0,6,0,0"/></StackPanel>
        </Border>
        <Border Grid.Row="3" Style="{StaticResource Card}" VerticalAlignment="Top" Visibility="{Binding NoCandidates, Converter={StaticResource VisibleWhenTrue}}">
          <StackPanel><TextBlock Text="还没有文件列表" FontWeight="SemiBold"/><TextBlock Text="选择范围后开始扫描；日常临时文件清理可以直接使用首页的一键清理。" Foreground="#657689" Margin="0,6,0,0"/></StackPanel>
        </Border>
        <DataGrid Grid.Row="3" ItemsSource="{Binding FilteredCandidates}" IsEnabled="{Binding Idle}" SelectionMode="Extended" AutomationProperties.Name="扫描候选文件" Visibility="{Binding HasFilteredCandidates, Converter={StaticResource VisibleWhenTrue}}">
          <DataGrid.Columns>
            <DataGridTemplateColumn Header="选择" Width="55"><DataGridTemplateColumn.CellTemplate><DataTemplate><CheckBox IsChecked="{Binding Selected, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center" VerticalAlignment="Center" AutomationProperties.Name="选择此文件"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
            <DataGridTextColumn Header="文件路径" Binding="{Binding Path}" Width="*" IsReadOnly="True"><DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="ToolTip" Value="{Binding Path}"/><Setter Property="TextTrimming" Value="CharacterEllipsis"/><Setter Property="TextWrapping" Value="NoWrap"/><Setter Property="VerticalAlignment" Value="Center"/></Style></DataGridTextColumn.ElementStyle></DataGridTextColumn>
            <DataGridTextColumn Header="逻辑大小" Binding="{Binding Size}" SortMemberPath="Bytes" Width="105" IsReadOnly="True"/>
            <DataGridTextColumn Header="修改时间" Binding="{Binding Modified}" Width="160" IsReadOnly="True"/>
            <DataGridTextColumn Header="规则 / 风险" Binding="{Binding Reason}" Width="200" IsReadOnly="True"/>
          </DataGrid.Columns>
        </DataGrid>
        <Expander Grid.Row="4" Header="扫描错误详情（最多保留 1000 条）" Margin="0,10,0,0" Visibility="{Binding HasScanIssues, Converter={StaticResource VisibleWhenTrue}}">
          <DataGrid ItemsSource="{Binding ScanIssues}" Height="120" IsReadOnly="True"><DataGrid.Columns><DataGridTextColumn Header="路径" Binding="{Binding Path}" Width="*"/><DataGridTextColumn Header="原因" Binding="{Binding Message}" Width="300"/></DataGrid.Columns></DataGrid>
        </Expander>
      </Grid>
    </DataTemplate>
  </Window.Resources>
  <Grid>
    <Grid.ColumnDefinitions><ColumnDefinition Width="205"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Border Background="#172A3A"><DockPanel Margin="16,30,16,20">
      <StackPanel DockPanel.Dock="Top" Margin="12,0,0,32"><StackPanel Orientation="Horizontal"><Border Background="#168574" CornerRadius="10" Width="36" Height="36" Margin="0,0,10,0"><TextBlock Text="&#xE73E;" FontFamily="Segoe MDL2 Assets" Foreground="White" FontSize="19" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock Text="Clean" Foreground="#F2F6FA" FontSize="27" FontWeight="SemiBold"/></StackPanel><TextBlock Text="给电脑，留一点轻盈" Foreground="#A3B8CC" Margin="0,14,0,0" FontSize="12"/></StackPanel>
      <ListBox ItemsSource="{Binding NavigationItems}" SelectedItem="{Binding SelectedNavigation}" Background="Transparent" BorderThickness="0" Foreground="#A3B8CC" VerticalAlignment="Top" AutomationProperties.Name="页面导航" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
        <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="Padding" Value="14,14"/><Setter Property="Margin" Value="0,0,0,6"/><Setter Property="Cursor" Value="Hand"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="AutomationProperties.Name" Value="{Binding Label}"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border x:Name="ItemSurface" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="10" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ItemSurface" Property="Background" Value="#20394B"/></Trigger><Trigger Property="IsSelected" Value="True"><Setter TargetName="ItemSurface" Property="Background" Value="#294757"/></Trigger><Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="ItemSurface" Property="BorderBrush" Value="#A3B8CC"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style></ListBox.ItemContainerStyle>
        <ListBox.ItemTemplate><DataTemplate><StackPanel Orientation="Horizontal"><TextBlock Text="{Binding Icon}" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="#A3B8CC" VerticalAlignment="Center" Margin="0,0,13,0"/><TextBlock Text="{Binding Label}" Foreground="#A3B8CC"/></StackPanel></DataTemplate></ListBox.ItemTemplate>
      </ListBox>
    </DockPanel></Border>
    <Grid Grid.Column="1">
      <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <TabControl Foreground="#223347" SelectedIndex="{Binding SelectedPage}" Background="Transparent" BorderThickness="0" Margin="28,28,28,16">
        <TabControl.Resources><Style TargetType="TabItem"><Setter Property="Visibility" Value="Collapsed"/></Style></TabControl.Resources>
        <TabItem><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
          <TextBlock Text="让空间，回到手边" Style="{StaticResource Title}"/><TextBlock Text="日常清理，一个按钮就够了。" Style="{StaticResource Subtitle}"/>
          <Border BorderBrush="#CBE5DF" BorderThickness="1" CornerRadius="18" Padding="24" Margin="0,0,0,18">
            <Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#E0F3ED" Offset="0"/><GradientStop Color="#F0F8F6" Offset="1"/></LinearGradientBrush></Border.Background>
            <StackPanel>
              <StackPanel Orientation="Horizontal" Margin="0,0,0,16"><Border Background="#C8E9DF" CornerRadius="12" Width="44" Height="44"><TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets" FontSize="22" Foreground="#168574" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel VerticalAlignment="Center" Margin="12,0,0,0"><TextBlock Text="日常清理" Foreground="#165E52" FontWeight="SemiBold"/><TextBlock Text="仅处理过期的用户临时文件" Foreground="#537B70" FontSize="12" Margin="0,3,0,0"/></StackPanel></StackPanel>
              <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,18,0"><TextBlock Text="清理一下，轻装运行" FontSize="23" FontWeight="SemiBold" Foreground="#165E52"/>
                  <TextBlock Text="{Binding QuickScope}" Foreground="#426B62" Margin="0,7,0,0"/>
                  <TextBlock Text="保留排除目录，跳过占用文件。点击即执行，无需勾选。" Foreground="#426B62" Margin="0,4,0,0"/>
                </StackPanel>
                <Button Grid.Column="1" Content="一键清理" Command="{Binding QuickCleanCommand}" FontSize="18" FontWeight="SemiBold" Padding="28,15" Margin="0" VerticalAlignment="Center" AutomationProperties.Name="一键清理过期临时文件"/>
              </Grid>
            </StackPanel>
          </Border>
          <Border Style="{StaticResource Card}" Visibility="{Binding HasQuickSession, Converter={StaticResource VisibleWhenTrue}}"><StackPanel><DockPanel><Button DockPanel.Dock="Right" Content="清理详情 →" Command="{Binding ShowReportCommand}" Style="{StaticResource SecondaryButton}" Margin="12,0,0,0"/><TextBlock Text="本次清理" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/></DockPanel><TextBlock Text="{Binding QuickSummary}" Foreground="#53716C" Margin="0,10,0,0" AutomationProperties.LiveSetting="Polite"/><ProgressBar Height="4" Foreground="{StaticResource Accent}" Margin="0,12,0,0" IsIndeterminate="{Binding QuickCleaning}" Visibility="{Binding QuickCleaning, Converter={StaticResource VisibleWhenTrue}}"/></StackPanel></Border>
          <Border Style="{StaticResource Card}"><StackPanel><DockPanel><Button DockPanel.Dock="Right" Content="刷新概览" Command="{Binding RefreshOverviewCommand}" Style="{StaticResource SecondaryButton}"/><TextBlock Text="本地磁盘" FontSize="18" FontWeight="SemiBold"/></DockPanel>
            <ItemsControl ItemsSource="{Binding DiskRows}" Margin="0,16,0,0"><ItemsControl.ItemTemplate><DataTemplate><Grid Margin="0,0,0,16"><Grid.ColumnDefinitions><ColumnDefinition Width="55"/><ColumnDefinition Width="*"/><ColumnDefinition Width="230"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Name}" FontSize="17"/><ProgressBar Grid.Column="1" Value="{Binding UsedPercent}" Height="9" Foreground="{StaticResource Accent}" Background="#E6EEF1" BorderThickness="0" VerticalAlignment="Center"/><StackPanel Grid.Column="2" Margin="18,0,0,0"><TextBlock><Run Text="可用 "/><Run Text="{Binding Available}"/><Run Text=" / "/><Run Text="{Binding Total}"/></TextBlock><TextBlock Text="{Binding Error}" Foreground="#A23E32"/></StackPanel></Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
          </StackPanel></Border>
          <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="物理内存" FontSize="17" FontWeight="SemiBold"/><TextBlock Text="{Binding MemorySummary}" Margin="0,10,0,12"/><ProgressBar Value="{Binding MemoryPercent}" Height="7" Foreground="#5687AF" Background="#E6EEF1" BorderThickness="0"/><TextBlock Text="仅监控，不强制释放内存。" Foreground="#657689" Margin="0,10,0,0"/></StackPanel></Border>
            <Border Grid.Column="2" Style="{StaticResource Card}"><StackPanel><TextBlock Text="Windows 回收站" FontSize="17" FontWeight="SemiBold"/><TextBlock Text="{Binding BinSummary}" Margin="0,10,0,12"/><WrapPanel><Button Content="打开回收站" Command="{Binding OpenBinCommand}" Style="{StaticResource SecondaryButton}" Padding="12,7"/><Button Content="清空…" Command="{Binding EmptyBinCommand}" Background="#657689" Padding="12,7"/></WrapPanel><TextBlock Text="单独操作，不参与一键清理。" Foreground="#657689" Margin="0,10,0,0"/></StackPanel></Border>
          </Grid>
        </StackPanel></ScrollViewer></TabItem>
        <TabItem><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
          <StackPanel><TextBlock Text="临时文件" Style="{StaticResource Title}"/><TextBlock Text="时间较久只代表值得检查，不代表一定可以删除。所有结果默认不勾选。" Style="{StaticResource Subtitle}"/><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="{Binding TemporaryDirectory}" FontFamily="Consolas" Margin="0,0,0,14"/><WrapPanel VerticalAlignment="Center"><TextBlock Text="排除最近" VerticalAlignment="Center"/><TextBox Text="{Binding AgeDaysText, UpdateSourceTrigger=PropertyChanged}" Width="65" Margin="10,0" IsEnabled="{Binding Idle}" AutomationProperties.Name="临时文件天数阈值"/><TextBlock Text="天内修改的文件" VerticalAlignment="Center" Margin="0,0,20,0"/><Button Content="开始只读扫描" Command="{Binding ScanTemporaryCommand}"/></WrapPanel></StackPanel></Border></StackPanel>
          <ContentControl Grid.Row="1" Content="{Binding}" ContentTemplate="{StaticResource ScanResults}"/>
        </Grid></TabItem>
        <TabItem><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
          <Button Content="← 返回" Command="{Binding CloseReportCommand}" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left" Margin="0,0,0,16"/>
          <TextBlock Text="清理详情" Style="{StaticResource Title}"/><TextBlock Text="本次任务的进度与处理结果。" Style="{StaticResource Subtitle}"/>
          <Border Style="{StaticResource Card}" Visibility="{Binding HasQuickSession, Converter={StaticResource VisibleWhenTrue}}"><StackPanel><TextBlock Text="{Binding QuickSummary}" FontSize="16" FontWeight="SemiBold"/><ProgressBar Height="4" Foreground="{StaticResource Accent}" Margin="0,12,0,0" IsIndeterminate="{Binding QuickCleaning}" Visibility="{Binding QuickCleaning, Converter={StaticResource VisibleWhenTrue}}"/></StackPanel></Border>
          <Border Style="{StaticResource Card}" Visibility="{Binding HasCandidates, Converter={StaticResource VisibleWhenTrue}}">
            <StackPanel><TextBlock Text="手动清理" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,10"/>
              <WrapPanel><CheckBox Content="永久删除（需单独确认）" IsChecked="{Binding Permanent}" IsEnabled="{Binding Idle}" VerticalAlignment="Center" Margin="0,0,16,0"/><Button Content="重新生成预览" Command="{Binding BuildPlanCommand}"/><Button Content="确认并执行…" Command="{Binding ExecutePlanCommand}"/></WrapPanel>
              <TextBlock Text="{Binding PlanSummary}" Foreground="#657689" Margin="0,10,0,0"/>
            </StackPanel>
          </Border>
          <DataGrid ItemsSource="{Binding PlanItems}" MaxHeight="210" Margin="0,0,0,12" IsReadOnly="True" Visibility="{Binding HasPlanItems, Converter={StaticResource VisibleWhenTrue}}" AutomationProperties.Name="待执行清理计划"><DataGrid.Columns><DataGridTextColumn Header="批准的文件路径" Binding="{Binding Path}" Width="*"/><DataGridTextColumn Header="字节数" Binding="{Binding Bytes}" Width="100"/><DataGridTextColumn Header="规则依据" Binding="{Binding Reason}" Width="240"/></DataGrid.Columns></DataGrid>
          <Border Style="{StaticResource Card}" Visibility="{Binding HasResults, Converter={StaticResource VisibleWhenTrue}}">
            <StackPanel><TextBlock Text="本次结果" FontSize="17" FontWeight="SemiBold"/><TextBlock Text="{Binding ReportSummary}" Margin="0,8,0,5"/><TextBlock Text="{Binding SpaceSummary}" Foreground="#657689"/></StackPanel>
          </Border>
          <DataGrid ItemsSource="{Binding Results}" MaxHeight="340" IsReadOnly="True" Visibility="{Binding HasResults, Converter={StaticResource VisibleWhenTrue}}" AutomationProperties.Name="逐项执行结果"><DataGrid.Columns><DataGridTextColumn Header="路径" Binding="{Binding Path}" Width="*"/><DataGridTextColumn Header="状态" Binding="{Binding Status}" Width="60"/><DataGridTextColumn Header="方式" Binding="{Binding Mode}" Width="80"/><DataGridTextColumn Header="逻辑大小" Binding="{Binding Size}" Width="90"/><DataGridTextColumn Header="结果说明" Binding="{Binding Message}" Width="250"/></DataGrid.Columns></DataGrid>
          <Expander Header="无法扫描的位置" Margin="0,10,0,0" Visibility="{Binding HasScanIssues, Converter={StaticResource VisibleWhenTrue}}"><DataGrid ItemsSource="{Binding ScanIssues}" MaxHeight="160" IsReadOnly="True"><DataGrid.Columns><DataGridTextColumn Header="路径" Binding="{Binding Path}" Width="*"/><DataGridTextColumn Header="原因" Binding="{Binding Message}" Width="280"/></DataGrid.Columns></DataGrid></Expander>
        </StackPanel></ScrollViewer></TabItem>
        <TabItem><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
          <StackPanel><TextBlock Text="大文件分析" Style="{StaticResource Title}"/><TextBlock Text="大文件不等于垃圾。选择普通本地目录，仅分析你指定的范围。" Style="{StaticResource Subtitle}"/><Border Style="{StaticResource Card}"><StackPanel><DockPanel Margin="0,0,0,12"><Button DockPanel.Dock="Right" Content="选择目录…" Command="{Binding BrowseFolderCommand}" Margin="10,0,0,0"/><TextBox Text="{Binding LargeFolder, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding Idle}" AutomationProperties.Name="大文件分析目录"/></DockPanel><WrapPanel><TextBlock Text="最低大小" VerticalAlignment="Center"/><TextBox Text="{Binding MinimumMBText, UpdateSourceTrigger=PropertyChanged}" Width="90" Margin="10,0" IsEnabled="{Binding Idle}" AutomationProperties.Name="大文件最低大小"/><TextBlock Text="MB" VerticalAlignment="Center" Margin="0,0,20,0"/><Button Content="开始大文件分析" Command="{Binding ScanLargeCommand}"/></WrapPanel></StackPanel></Border></StackPanel>
          <ContentControl Grid.Row="1" Content="{Binding}" ContentTemplate="{StaticResource ScanResults}"/>
        </Grid></TabItem>
        <TabItem><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><StackPanel><TextBlock Text="内存监控" Style="{StaticResource Title}"/><TextBlock Text="查看占用，不干扰程序运行。此页面可见时约每 2 秒刷新。" Style="{StaticResource Subtitle}"/><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="{Binding MemorySummary}" FontSize="18"/><ProgressBar Value="{Binding MemoryPercent}" Height="10" Margin="0,16,0,12" Foreground="#5687AF" Background="#E6EEF1" BorderThickness="0"/><TextBlock Text="{Binding MemoryTimestamp}" Foreground="#657689"/></StackPanel></Border><TextBlock Text="进程工作集包含共享页，不能相加作为系统内存用量。" Margin="0,0,0,12"/></StackPanel><DataGrid Grid.Row="1" ItemsSource="{Binding ProcessRows}" IsReadOnly="True"><DataGrid.Columns><DataGridTextColumn Header="PID" Binding="{Binding Id}" Width="90"/><DataGridTextColumn Header="进程名称" Binding="{Binding Name}" Width="*"/><DataGridTextColumn Header="工作集（按占用降序）" Binding="{Binding WorkingSet}" Width="240" CanUserSort="False"/></DataGrid.Columns></DataGrid></Grid></TabItem>
        <TabItem><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
          <TextBlock Text="设置与历史" Style="{StaticResource Title}"/><TextBlock Text="设置保存在本机，排除目录同时用于一键清理和手动扫描。" Style="{StaticResource Subtitle}"/>
          <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="260"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="扫描偏好" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,12"/>
              <DockPanel Margin="0,0,0,10"><TextBox DockPanel.Dock="Right" Text="{Binding AgeDaysText, UpdateSourceTrigger=PropertyChanged}" Width="65" IsEnabled="{Binding Idle}" AutomationProperties.Name="临时文件最低年龄"/><TextBlock Text="临时文件年龄 / 天" VerticalAlignment="Center"/></DockPanel>
              <DockPanel><TextBox DockPanel.Dock="Right" Text="{Binding MinimumMBText, UpdateSourceTrigger=PropertyChanged}" Width="65" IsEnabled="{Binding Idle}" AutomationProperties.Name="大文件阈值"/><TextBlock Text="大文件阈值 / MB" VerticalAlignment="Center"/></DockPanel>
              <TextBlock Text="一键清理至少保留最近 7 天的文件。" Foreground="#657689" FontSize="12" Margin="0,10,0,0"/>
            </StackPanel></Border>
            <Border Grid.Column="2" Style="{StaticResource Card}"><StackPanel><DockPanel Margin="0,0,0,10"><Button DockPanel.Dock="Right" Content="添加目录…" Command="{Binding AddExclusionCommand}" Padding="12,6" Margin="8,0,0,0"/><TextBlock Text="排除目录" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center"/></DockPanel>
              <TextBox Text="{Binding ExclusionsText, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" Height="82" VerticalScrollBarVisibility="Auto" IsEnabled="{Binding Idle}" AutomationProperties.Name="排除目录列表"/>
              <TextBlock Text="每行一个完整路径；留空表示没有自定义排除。" Foreground="#657689" FontSize="12" Margin="0,8,0,0"/>
            </StackPanel></Border>
          </Grid>
          <Button Content="保存设置" Command="{Binding SaveSettingsCommand}" HorizontalAlignment="Left" Margin="0,0,0,20"/>
          <Border Style="{StaticResource Card}"><StackPanel>
            <DockPanel Margin="0,0,0,12"><Button DockPanel.Dock="Right" Content="清除历史与日志" Command="{Binding ClearHistoryCommand}" Background="#657689" Padding="12,7" Margin="8,0,0,0"/><TextBlock Text="最近的清理" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center"/></DockPanel>
            <TextBlock Text="还没有清理记录。完成首次清理后，这里会显示结果摘要，最多保留 50 条。" Foreground="#657689" Margin="0,0,0,4" Visibility="{Binding NoHistory, Converter={StaticResource VisibleWhenTrue}}"/>
            <DataGrid ItemsSource="{Binding HistoryRows}" MaxHeight="250" IsReadOnly="True" Visibility="{Binding HasHistory, Converter={StaticResource VisibleWhenTrue}}"><DataGrid.Columns><DataGridTextColumn Header="时间" Binding="{Binding Started, StringFormat=MM-dd HH:mm}" Width="100"/><DataGridTextColumn Header="状态" Binding="{Binding State}" Width="*"/><DataGridTextColumn Header="计划" Binding="{Binding Planned}" Width="50"/><DataGridTextColumn Header="回收站" Binding="{Binding Recycled}" Width="60"/><DataGridTextColumn Header="删除" Binding="{Binding Deleted}" Width="50"/><DataGridTextColumn Header="失败" Binding="{Binding Failed}" Width="50"/><DataGridTextColumn Header="跳过" Binding="{Binding Skipped}" Width="50"/><DataGridTextColumn Header="未执行" Binding="{Binding NotExecuted}" Width="65"/></DataGrid.Columns></DataGrid>
          </StackPanel></Border>
          <Expander Header="本地数据与隐私" Foreground="#657689"><StackPanel Margin="0,10,0,0"><TextBlock Text="{Binding StateDirectory}" FontFamily="Consolas"/><TextBlock Text="历史只保留摘要，诊断日志不记录文件路径。" Foreground="#657689" Margin="0,6,0,0"/></StackPanel></Expander>
        </StackPanel></ScrollViewer></TabItem>
      </TabControl>
      <Border Grid.Row="1" Background="#F5F7FA" BorderBrush="#E2E9EF" BorderThickness="0,1,0,0" Padding="28,12"><DockPanel><Button DockPanel.Dock="Right" Content="停止操作" Command="{Binding CancelCommand}" Visibility="{Binding Busy, Converter={StaticResource VisibleWhenTrue}}" Style="{StaticResource SecondaryButton}" Margin="16,0,0,0"/><Ellipse Width="6" Height="6" Fill="{StaticResource Accent}" Margin="0,0,9,0"/><TextBlock Text="{Binding Status}" Foreground="#718190" FontSize="12" VerticalAlignment="Center" MaxHeight="54" AutomationProperties.LiveSetting="Polite"/></DockPanel></Border>
    </Grid>
  </Grid>
</Window>


